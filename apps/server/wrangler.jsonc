{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "unichat",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // L'application web est servie par le même Worker : une seule adresse, et
  // un cookie de session qui reste « first-party » (voir docs/ARCHITECTURE.md).
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // `wrangler dev` et `wrangler deploy` construisent d'abord l'application web.
  "build": {
    "command": "npm run build --workspace @unichat/web",
    "cwd": "../..",
    "watch_dir": ["../web/src", "../web/index.html", "../../packages/shared/src"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unichat",
      "database_id": "90e76eb6-e591-4913-9e5f-9b4b2d64d0f6",
      "migrations_dir": "migrations"
    }
  ],

  // Une boîte aux lettres par utilisateur : connexions temps réel et messages
  // en attente de remise. Stockage SQLite, seul disponible sur l'offre gratuite.
  "durable_objects": {
    "bindings": [{ "name": "BOITE", "class_name": "Boite" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Boite"] }],

  // Nettoyage quotidien (états de connexion, compteurs, vieilles sessions).
  "triggers": { "crons": ["17 3 * * *"] }
}
