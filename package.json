{
  "name": "unichat",
  "private": true,
  "description": "UniChat : messagerie web, Android et desktop, avec une API d'intégration.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @unichat/server",
    "build": "npm run build --workspace @unichat/web",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspace @unichat/server",
    "deploy": "npm run deploy --workspace @unichat/server"
  },
  "engines": {
    "node": ">=20"
  }
}
